# Example systemd unit for dellfanctl. `dellfanctl install-service` writes
# a copy of this (with paths filled in) to /etc/systemd/system/. This file
# is kept in the repo for reference and for manual installs.

[Unit]
Description=Dell iDRAC fan control (dellfanctl)
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/dellfanctl run --config /etc/dellfanctl/config.yaml
Restart=on-failure
RestartSec=5
# SIGTERM triggers a graceful shutdown that hands fan control back to the
# iDRAC before exiting; give it a little room to do so.
TimeoutStopSec=15

# systemd creates/owns /var/log/dellfanctl (root:root, mode 0750); the
# service's own stdout/stderr is appended there instead of only going to
# the journal. See deploy/dellfanctl.logrotate for rotating this file.
LogsDirectory=dellfanctl
StandardOutput=append:%L/dellfanctl/dellfanctl.log
StandardError=append:%L/dellfanctl/dellfanctl.log

[Install]
WantedBy=multi-user.target
